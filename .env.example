# --- Site ---
PORT=3000
BASE_URL=http://localhost:3000   # live: https://pstappraisal.ca
PRICE_CENTS=7000                 # $70.00 CAD before tax
TAX_PERCENT=5                    # GST added at checkout. Set to 0 until you're registered for GST
TAX_NAME=GST
TAX_NUMBER=                      # your GST/HST registration number, shown on the receipt

# --- Admin login (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Everything below can instead be entered in the admin portal (Admin → Settings), which overrides these.

# --- Stripe (leave blank to run in test mode with no payment) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (leave SMTP_HOST blank to save emails to output/ instead) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@pstappraisal.ca
SMTP_PASS=app-password
MAIL_FROM="PST Appraisal BC <support@pstappraisal.ca>"
MAIL_BCC=support@pstappraisal.ca       # keep a copy of every appraisal sent

# --- Printed on the appraisal ---
COMPANY_NAME=PST Appraisal BC
COMPANY_STREET=PMB 56117, 915 E Cordova St
COMPANY_CITY=Vancouver
COMPANY_PROVINCE=BC
COMPANY_POSTAL=V6A 4B8
BUSINESS_NUMBER=                 # CRA business number (shown on the FIN 320, optional)
PST_NUMBER=                      # BC PST number, if you have one
COMPANY_PHONE=604.635.3867
APPRAISER_NAME=Your Name
APPRAISER_LICENSE=               # Your VSA dealer registration # or appraiser credential
SIGNATURE_IMAGE=templates/signature.png

# --- New order alerts ---
NOTIFY_EMAIL=adam@khamis.ca      # gets an email with a link to review and confirm each paid order
VOIPMS_API_USERNAME=             # your voip.ms login email
VOIPMS_API_PASSWORD=             # the API password set in voip.ms → Main Menu → SOAP and REST/JSON API
VOIPMS_DID=6046353867            # the company number the text is sent from (must have SMS enabled)
NOTIFY_SMS_TO=6044185518         # your mobile
