# --- Site ---
PORT=3000
BASE_URL=http://localhost:3000   # live: https://pstappraisal.ca
PRICE_CENTS=9900                 # $99.00 CAD

# --- Admin login (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Stripe (leave blank to run in test mode with no payment) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AUTOMATIC_TAX=false       # true if you've set up Stripe Tax to add GST

# --- Email (leave SMTP_HOST blank to save emails to output/ instead) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@pstappraisal.ca
SMTP_PASS=app-password
MAIL_FROM="PST Appraisal BC <hello@pstappraisal.ca>"
MAIL_BCC=hello@pstappraisal.ca       # keep a copy of every appraisal sent

# --- Printed on the appraisal ---
COMPANY_NAME=PST Appraisal BC
COMPANY_ADDRESS=123 Main St, Vancouver, BC V6B 1A1
COMPANY_PHONE=(604) 555-0100
APPRAISER_NAME=Your Name
APPRAISER_LICENSE=               # Your VSA dealer registration # or appraiser credential
SIGNATURE_IMAGE=templates/signature.png
